# langflow.env.example
# Copy this file to .env and fill in your values
# Usage: source .env   (Linux) or load via python-dotenv

# ── Database ──────────────────────────────────────────────────────────────────
LANGFLOW_DATABASE_URL=postgresql://langflowuser:YourPassword@<db-host>:5432/langflow

# ── Authentication ────────────────────────────────────────────────────────────
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=YourStrongPassword
LANGFLOW_AUTO_LOGIN=false
LANGFLOW_SECRET_KEY=generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# ── Job Queue ─────────────────────────────────────────────────────────────────
# Use 'sync' on Windows; 'async' on Linux for better performance
LANGFLOW_JOB_QUEUE=sync

# ── Langfuse Observability (optional) ─────────────────────────────────────────
# Get keys from your Langfuse project: Settings → API Keys
LANGFUSE_HOST=http://<langfuse-vm-ip>:3001
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here

# ── Keycloak SSO (optional) ───────────────────────────────────────────────────
# KEYCLOAK_SERVER_URL=https://your-keycloak-domain.com
# KEYCLOAK_REALM=your-realm
# KEYCLOAK_CLIENT_ID=your-client-id
# KEYCLOAK_CLIENT_SECRET=your-client-secret
# KEYCLOAK_REDIRECT_URI=https://your-langflow-domain.com/auth/callback
